{
  "name": "tabius-desktop",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --fail-on-warnings && biome check . --error-on-warnings",
    "test": "bun test --conditions=browser --preload ./frontend/test/setup.ts",
    "build": "svelte-check --fail-on-warnings && vite build",
    "format": "biome format --write .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "phosphor-svelte": "3.1.1",
    "svelte": "5.59.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "happy-dom": "21.0.4",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
