{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!target",
      "!!dist",
      "!!gen",
      "!!bun.lock",
      "!!Cargo.lock"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
