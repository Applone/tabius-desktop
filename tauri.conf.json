{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabius",
  "version": "0.1.0",
  "identifier": "dev.tabius.desktop",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tabius",
        "dragDropEnabled": false,
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A focused SSH workspace",
    "icon": [
      "assets/icons/icon.png",
      "assets/icons/icon.ico",
      "assets/icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
